{
  "kind": "collectionType",
  "collectionName": "journal_entries",
  "info": {
    "singularName": "journal-entry",
    "pluralName": "journal-entries",
    "displayName": "Journal Entry",
    "description": "General Ledger Journal Entries for Double Entry Accounting"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "entryDate": {
      "type": "date",
      "required": true
    },
    "reference": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "details": {
      "type": "component",
      "repeatable": true,
      "component": "finance.journal-item"
    },
    "isAutoGenerated": {
      "type": "boolean",
      "default": false
    },
    "totalDebit": {
      "type": "decimal"
    },
    "totalCredit": {
      "type": "decimal"
    }
  }
}
