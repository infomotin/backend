{
  "kind": "collectionType",
  "collectionName": "divisions",
  "info": {
    "singularName": "division",
    "pluralName": "divisions",
    "displayName": "Division",
    "description": "Administrative divisions (e.g., Dhaka, Chittagong)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "bnName": {
      "type": "string"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "divisions"
    },
    "districts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::district.district",
      "mappedBy": "division"
    }
  }
}
