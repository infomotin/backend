{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Inventory Items (Fuel, Lubes, Goods)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "products"
    },
    "subCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-sub-category.product-sub-category",
      "inversedBy": "products"
    },
    "childCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-child-category.product-child-category",
      "inversedBy": "products"
    },
    "baseUnit": {
      "type": "string",
      "required": true,
      "default": "Pcs"
    },
    "purchaseUnit": {
      "type": "string",
      "default": "Pcs"
    },
    "saleUnit": {
      "type": "string",
      "default": "Pcs"
    },
    "purchaseToSaleFactor": {
      "type": "decimal",
      "default": 1
    },
    "saleToBaseFactor": {
      "type": "decimal",
      "default": 1
    },
    "costPrice": {
      "type": "decimal",
      "required": true
    },
    "sellingPrice": {
      "type": "decimal",
      "required": true
    },
    "stockQuantity": {
      "type": "decimal",
      "default": 0,
      "description": "Total stock in base units"
    },
    "alertLevel": {
      "type": "integer",
      "default": 10
    },
    "taxRate": {
      "type": "decimal",
      "default": 0
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-variant.product-variant",
      "mappedBy": "product"
    },
    "supplier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::supplier.supplier"
    },
    "description": {
      "type": "text"
    },
    "attributes": {
      "type": "json",
      "description": "Dynamic attributes like Color, Brand, RAM, etc."
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-brand.product-brand",
      "inversedBy": "products"
    },
    "manufacturer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-manufacturer.product-manufacturer",
      "inversedBy": "products"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
