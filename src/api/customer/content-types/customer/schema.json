{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "Customer Profiles"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "addressLine": {
      "type": "text"
    },
    "country": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::country.country"
    },
    "division": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::division.division"
    },
    "district": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::district.district"
    },
    "upazila": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::upazila.upazila"
    },
    "cityCorporation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::city-corporation.city-corporation"
    },
    "zone": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::zone.zone"
    },
    "customerType": {
      "type": "enumeration",
      "enum": ["Retail", "Corporate", "Government"],
      "default": "Retail"
    },
    "creditLimit": {
      "type": "decimal",
      "default": 0
    },
    "currentBalance": {
      "type": "decimal",
      "default": 0
    },
    "sales": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sale.sale",
      "mappedBy": "customer"
    }
  }
}
